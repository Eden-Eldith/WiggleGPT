          "record_id": "instruction/practical"
        },
        {
          "id": "science",
          "prompt": "What is the difference between a planet and a star?",
          "serialised_prompt": "<|user|>\nWhat is the difference between a planet and a star?\n<|/user|>\n<|assistant|>\n",
          "answer": "A planet and a star are two distinct concepts that have different origins, shapes, and forms. Understanding the distinction between them is crucial for understanding the properties of planets in various planetary systems like stars or planets in orbit around their host star at the galactic center (GCC).",
          "seconds": 1.063,
