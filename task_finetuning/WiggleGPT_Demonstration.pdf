        },
        {
          "id": "creative",
          "prompt": "Write a short story about a lighthouse keeper who discovers a message in a bottle.",
          "serialised_prompt": "<|user|>\nWrite a short story about a lighthouse keeper who discovers a message in a bottle.\n<|/user|>\n<|assistant|>\n",
          "answer": "As the last remnants of sunlight faded, the lighthouse stood sentinel over the edge of the English countryside. The sounds of the sea and the creaking of old wooden beams stretched out before her like a whispered warning. The keeper, a young woman named Elara, had come to the aid of a shipwrecked sailor who had been stranded on the side of a dense forest for weeks. The message was etched in the glass: \"Lift your spirit. We have found you.\"",
          "seconds": 1.662,
          "visible_text_tokens": 97,
          "record_id": "instruction/creative"
        },
        {
          "id": "dialogue",
          "prompt": "Write a friendly conversation between a gardener and a curious robot.",
          "serialised_prompt": "<|user|>\nWrite a friendly conversation between a gardener and a curious robot.\n<|/user|>\n<|assistant|>\n",
          "answer": "The sun beats down on the rolling hills, casting a golden glow over the lush oases of this quaint village. As the sun sets, the gentle hum of garden plants and the soft rustle of leaves help to purify the air, making the villagers feel at peace despite the harsh weather conditions. The smell of blooming wildflowers wafts through the gardens, teasing the senses with its sweet fragrance that seems to match their own skin tones - a scent that draws the attention of passersby all day long.\"",
          "seconds": 1.783,
          "visible_text_tokens": 103,
          "record_id": "instruction/dialogue"
        },
